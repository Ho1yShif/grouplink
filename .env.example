# grouplink env contract, grouped by the package that owns each variable.
# Copy to .env for local runs. Everything below is read lazily, at first use.

# --- @render-lab/tasks-notion ---
# Internal integration token, shared with the links database.
NOTION_TOKEN=
NOTION_LINKS_DATABASE_ID=
# Name, Slug, Tagline. The links database relates to it through a People column.
NOTION_PEOPLE_DATABASE_ID=

# --- @render-lab/tasks-render-kv ---
# Internal connection string of the grouplink-cache Key Value instance.
REDIS_URL=

# --- @render-lab/tasks-github ---
# Needs contents:write on the site repo.
GITHUB_TOKEN=
GITHUB_REPO_OWNER=Ho1yShif
GITHUB_REPO_NAME=grouplink
GITHUB_BRANCH=main

# --- @render-lab/tasks-render ---
RENDER_API_KEY=
RENDER_STATIC_SITE_ID=

# --- @render-lab/tasks-slack (optional) ---
# Unset means the run digest goes to the console instead.
# SLACK_WEBHOOK_URL=

# --- grouplink config ---
DRY_RUN=true                    # default; set to false to commit and deploy
SITE_URL=
# Slug of the person the root page shows. Their page is written to both
# site/index.html and site/<slug>/index.html.
SITE_DEFAULT_SLUG=shifra
# SITE_OVERLINE=Links
# SITE_DIR=site
# METADATA_TTL_SECONDS=86400
# LINKS_LIMIT=100

# --- trigger layer (@render-lab/triggers): the cron service ---
WORKFLOW_SLUG=
CRON_TASK=grouplink.rebuild
